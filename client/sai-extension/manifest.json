{
  "manifest_version": 3,
  "name": "SAI - 업무 메시지 교정 도구",
  "version": "0.0.1",
  "action": {},
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/main.jsx"],
      "css": ["src/content/toolbar.css", "src/content/tokens.css"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "SAI 사이드패널 열기/닫기"
    }
  },
  "permissions": ["activeTab", "storage", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}